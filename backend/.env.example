# --- Database (PostgreSQL with pgvector extension REQUIRED; no SQLite fallback) ---
DATABASE_URL=postgresql+psycopg://intel:intel@localhost:5432/inteldocs

# --- Redis (job queue for ARQ workers: document processing + eval runs) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
SECRET_KEY=change-me-to-a-random-64-char-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Groq (free tier LLM; leave blank to disable LLM-dependent features) ---
# NOTE: "llama-3.3-70b-versatile" has been decommissioned by Groq (verified
# live -- 404 model_not_found). Using "openai/gpt-oss-120b", Groq's current
# free-tier flagship open-weights model, instead.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Local models (no API keys needed, downloaded from HuggingFace on first run) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- OCR (Tesseract must be installed on PATH / in the container) ---
TESSERACT_CMD=tesseract

# --- Local file storage for uploaded originals (mounted volume in Docker) ---
STORAGE_DIR=./storage

# --- Misc ---
ENVIRONMENT=development
LOG_LEVEL=INFO
